<UserControl x:Class="Otoink.App.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="HistoryList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="0,18,0,0">
              <StackPanel>
                <TextBlock Text="{Binding RawText}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="15"
                           LineHeight="22"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding CorrectedDisplay}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="{Binding CorrectedVisibility}" />
                <StackPanel Orientation="Horizontal"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Right">
                  <Button Content="{Binding OptimizeButtonText}"
                          Style="{StaticResource WinListButton}"
                          Margin="0,0,8,0"
                          IsEnabled="{Binding CanOptimize}"
                          Tag="{Binding}"
                          Click="OnOptimizeClick" />
                  <Button Content="{Binding InsertButtonText}"
                          Style="{StaticResource WinListButton}"
                          Tag="{Binding}"
                          Click="OnInsertClick" />
                </StackPanel>
                <Rectangle Style="{StaticResource Hairline}" Margin="0,18,0,0" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <StackPanel x:Name="EmptyHint"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Margin="0,0,40,24"
                IsHitTestVisible="False">
      <TextBlock x:Name="EmptyTitle"
                 FontSize="16"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimary}" />
      <TextBlock x:Name="EmptyBody"
                 FontSize="13"
                 Foreground="{DynamicResource TextSecondary}"
                 Margin="0,8,0,0"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
