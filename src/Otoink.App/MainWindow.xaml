<Window x:Class="Otoink.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="280"
        Height="108"
        Title="otoink"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource AppFont}"
        SourceInitialized="OnSourceInitialized">
  <Grid Background="{x:Null}">
    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
      <Border x:Name="ToastBar"
              Height="24"
              MinWidth="0"
              MaxWidth="200"
              CornerRadius="12"
              Background="#D8000000"
              BorderBrush="#28FFFFFF"
              BorderThickness="1"
              Padding="12,0"
              Margin="0,0,0,8"
              Visibility="Collapsed"
              Opacity="0"
              HorizontalAlignment="Center"
              IsHitTestVisible="False"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True">
        <TextBlock x:Name="ToastText"
                   FontFamily="Microsoft YaHei UI, Segoe UI"
                   FontSize="12"
                   FontWeight="Medium"
                   Foreground="#E8FFFFFF"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   TextOptions.TextFormattingMode="Ideal"
                   TextOptions.TextRenderingMode="ClearType" />
      </Border>

      <Grid HorizontalAlignment="Center" Height="56">
        <Ellipse x:Name="GlowHalo"
                 Width="248"
                 Height="58"
                 Opacity="0"
                 IsHitTestVisible="False"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center" />

        <Border x:Name="PillRing"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource PillStroke}"
                Cursor="Hand"
                MouseEnter="OnPillMouseEnter"
                MouseLeave="OnPillMouseLeave"
                PreviewMouseLeftButtonDown="OnPillPreviewMouseLeftButtonDown">
          <Border x:Name="Pill"
                  Margin="1"
                  Width="50"
                  Height="5"
                  CornerRadius="22"
                  Background="{DynamicResource PillFill}"
                  BorderThickness="0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True"
                  SizeChanged="OnPillSizeChanged">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="CancelCol" Width="0" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition x:Name="StopCol" Width="0" />
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton"
                    Grid.Column="0"
                    Style="{StaticResource GrokIconButton}"
                    Width="28"
                    Height="28"
                    Margin="8,0,0,0"
                    Background="#40FF5A5F"
                    Click="OnCancelClick"
                    Visibility="Collapsed">
              <Path Width="9"
                    Height="9"
                    Stretch="Uniform"
                    Stroke="{DynamicResource Danger}"
                    StrokeThickness="1.8"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Data="M 0,0 L 10,10 M 10,0 L 0,10" />
            </Button>

            <Grid Grid.Column="1" Margin="16,0,14,0">
              <DockPanel x:Name="HintRow"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False">
                <Border x:Name="KeyHint"
                        DockPanel.Dock="Right"
                        CornerRadius="6"
                        Padding="7,2"
                        Margin="10,0,0,0"
                        Background="#14FFFFFF"
                        BorderBrush="#2AFFFFFF"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Opacity="0">
                  <TextBlock x:Name="KeyHintText"
                             FontFamily="Cascadia Mono, Consolas, Segoe UI"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondary}" />
                </Border>
                <TextBlock x:Name="HintText"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Opacity="0"
                           TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <Canvas x:Name="WaveCanvas"
                      Height="28"
                      VerticalAlignment="Center"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"
                      UseLayoutRounding="False"
                      SnapsToDevicePixels="False" />
              <StackPanel x:Name="Dots"
                          Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed">
                <Ellipse x:Name="Dot0" Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="3,0">
                  <Ellipse.RenderTransform>
                    <TranslateTransform />
                  </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="{DynamicResource AccentSoft}" Margin="3,0">
                  <Ellipse.RenderTransform>
                    <TranslateTransform />
                  </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="3,0">
                  <Ellipse.RenderTransform>
                    <TranslateTransform />
                  </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="{DynamicResource AccentSoft}" Margin="3,0">
                  <Ellipse.RenderTransform>
                    <TranslateTransform />
                  </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Dot4" Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="3,0">
                  <Ellipse.RenderTransform>
                    <TranslateTransform />
                  </Ellipse.RenderTransform>
                </Ellipse>
              </StackPanel>
            </Grid>

            <Button x:Name="StopButton"
                    Grid.Column="2"
                    Style="{StaticResource GrokIconButton}"
                    Width="28"
                    Height="28"
                    Margin="0,0,8,0"
                    Background="#28FFFFFF"
                    Click="OnStopClick"
                    Visibility="Collapsed">
              <Border Width="9"
                      Height="9"
                      CornerRadius="2"
                      Background="#F4F4F5" />
            </Button>
          </Grid>
        </Border>
        </Border>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
