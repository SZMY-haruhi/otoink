<Window x:Class="Otoink.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="280"
        Height="96"
        Title="otoink"
        SourceInitialized="OnSourceInitialized">
  <Border CornerRadius="16"
          Background="#E62B2B2B"
          BorderBrush="#55FFFFFF"
          BorderThickness="1">
    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="20"
              Background="Transparent"
              MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
        <Grid>
          <Rectangle Width="28"
                     Height="3"
                     Fill="#CCCCCC"
                     RadiusX="1.5"
                     RadiusY="1.5"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False" />
          <Button Content="✕"
                  Width="20"
                  Height="18"
                  Margin="0,0,4,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="#CCCCCCCC"
                  FontSize="11"
                  Cursor="Hand"
                  Click="OnCloseClick" />
        </Grid>
      </Border>

      <Grid Margin="12,4,12,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Settings gear -->
        <Button x:Name="SettingsButton"
                Grid.Column="0"
                Width="36"
                Height="36"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="Settings"
                Click="OnSettingsClick">
          <Path Data="M19.14,12.94c0.04-0.31 0.06-0.63 0.06-0.94c0-0.31-0.02-0.63-0.06-0.94l2.03-1.58
                       c0.18-0.14 0.23-0.41 0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39 0.96
                       c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81C14.34,2.58 14.14,2.4 13.9,2.4h-3.8
                       c-0.24,0-0.44 0.18-0.5 0.41L9.26,5.35C8.67,5.59 8.14,5.91 7.64,6.29L5.25,5.33
                       C5.03,5.26 4.78,5.33 4.66,5.55L2.74,8.87C2.62,9.07 2.67,9.34 2.85,9.48l2.03,1.58
                       C4.84,11.37 4.82,11.69 4.82,12s0.02,0.63 0.06,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61
                       l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54
                       c0.06,0.23 0.26,0.41 0.5,0.41h3.8c0.24,0 0.44-0.18 0.5-0.41l0.36-2.54
                       c0.59-0.24 1.13-0.56 1.62-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59-0.22l1.92-3.32
                       c0.12-0.22 0.07-0.47-0.12-0.61L19.14,12.94z
                       M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6s3.6,1.62 3.6,3.6S13.98,15.6 12,15.6z"
                Fill="#CCCCCCCC"
                Stretch="Uniform"
                Width="18"
                Height="18" />
        </Button>

        <Popup x:Name="SettingsPopup"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="-8"
               VerticalOffset="-6" />

        <!-- Mic button -->
        <Button x:Name="MicButton"
                Grid.Column="1"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#33FFFFFF"
                BorderBrush="#55FFFFFF"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="Dictate"
                PreviewMouseLeftButtonDown="OnMicPreviewMouseLeftButtonDown">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="MicChrome"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="24">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Button.Template>
          <Path Data="M12,14c1.66,0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9,3.34 9,5v6C9,12.66 10.34,14 12,14z
                       M17,11c0,2.76-2.24,5-5,5s-5-2.24-5-5H5c0,3.53 2.61,6.43 6,6.92V21h2v-3.08
                       c3.39-0.49 6-3.39 6-6.92H17z"
                Fill="#7FDBFF"
                Stretch="Uniform"
                Width="22"
                Height="22" />
        </Button>

        <!-- History / panel toggle (placeholder) -->
        <Button Grid.Column="2"
                Width="36"
                Height="36"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="History">
          <Path Data="M4,6 H20 M4,12 H20 M4,18 H14 M16,16 L20,12 L16,8"
                Stroke="#CCCCCCCC"
                StrokeThickness="1.8"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                Stretch="Uniform"
                Width="18"
                Height="18"
                Fill="Transparent" />
        </Button>
      </Grid>
    </DockPanel>
  </Border>
</Window>
