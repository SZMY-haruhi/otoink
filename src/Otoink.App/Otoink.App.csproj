<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\otoink.ico</ApplicationIcon>
    <AssemblyName>otoink</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avoid WPF/WinForms ambiguous global usings (Brush, UserControl, …). -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Otoink.Core\Otoink.Core.csproj" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
    <PackageReference Include="SharpCompress" Version="0.48.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\otoink-logo.jpg" />
    <Content Include="Assets\otoink.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\models\sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17\tokens.txt')">
    <Content Include="$(MSBuildThisFileDirectory)..\..\models\sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17\**\*.*"
             Exclude="$(MSBuildThisFileDirectory)..\..\models\sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17\model.onnx">
      <Link>models\sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
