<UserControl x:Class="Otoink.App.SettingsFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="280"
             Background="Transparent">
  <Border CornerRadius="12"
          Background="#F02B2B2B"
          BorderBrush="#55FFFFFF"
          BorderThickness="1"
          Padding="12,10,12,12">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  MaxHeight="420"
                  CanContentScroll="False">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <CheckBox x:Name="DefaultAiInputToggle"
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Checked="OnDefaultAiInputChanged"
                    Unchecked="OnDefaultAiInputChanged" />
          <TextBlock Text="默认 AI 录入"
                     Foreground="#EEEEEE"
                     FontSize="13"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" />
        </DockPanel>

        <DockPanel Margin="0,0,0,8">
          <CheckBox x:Name="AutoPunctuationToggle"
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Checked="OnAutoPunctuationChanged"
                    Unchecked="OnAutoPunctuationChanged" />
          <TextBlock Text="自动标点符号"
                     Foreground="#EEEEEE"
                     FontSize="13"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" />
        </DockPanel>

        <TextBlock Text="麦克风"
                   Foreground="#AAAAAA"
                   FontSize="11"
                   Margin="0,4,0,4" />
        <ComboBox x:Name="MicrophoneCombo"
                  Margin="0,0,0,8"
                  SelectionChanged="OnMicrophoneSelectionChanged" />

        <TextBlock Text="API Base URL"
                   Foreground="#AAAAAA"
                   FontSize="11"
                   Margin="0,4,0,4" />
        <TextBox x:Name="ApiBaseUrlBox"
                 Margin="0,0,0,8"
                 Padding="4,3"
                 LostFocus="OnApiBaseUrlLostFocus"
                 TextChanged="OnApiFieldTextChanged" />

        <TextBlock Text="API Key"
                   Foreground="#AAAAAA"
                   FontSize="11"
                   Margin="0,4,0,4" />
        <PasswordBox x:Name="ApiKeyBox"
                     Margin="0,0,0,8"
                     Padding="4,3"
                     LostFocus="OnApiKeyLostFocus"
                     PasswordChanged="OnApiKeyPasswordChanged" />

        <TextBlock Text="API Model"
                   Foreground="#AAAAAA"
                   FontSize="11"
                   Margin="0,4,0,4" />
        <TextBox x:Name="ApiModelBox"
                 Margin="0,0,0,8"
                 Padding="4,3"
                 LostFocus="OnApiModelLostFocus"
                 TextChanged="OnApiFieldTextChanged" />

        <TextBlock Text="按住说话快捷键"
                   Foreground="#AAAAAA"
                   FontSize="11"
                   Margin="0,4,0,4" />
        <TextBox x:Name="HoldHotkeyBox"
                 Margin="0,0,0,10"
                 Padding="4,3"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="False"
                 Focusable="False" />

        <TextBlock Text="右侧按钮可展开历史记录。AI 优化不会自动发生，除非打开「默认 AI 录入」。"
                   Foreground="#999999"
                   FontSize="11"
                   TextWrapping="Wrap"
                   LineHeight="16" />
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
